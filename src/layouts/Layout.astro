---
import Header from "../components/Header.astro";
import Wavering from "../components/Wavering.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#f8f3f3" />
    <link rel="canonical" href={Astro.url} />
    <script
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="31fd1927-b0ad-4bc5-8de8-a5d326e02548"></script>
    <slot name="head" />
  </head>
  <body>
    <div class="page">
      <Wavering />
      <Header />
      <slot />
    </div>
    <p class="copy">&copy; 2026 Wavering Light LLC</p>
  </body>
</html>

<style>
  .page {
    max-width: 34rem;
    padding: 1.5rem;
    border: 2px solid rgba(39, 39, 39, 0.92);
    margin: 0 auto;
    box-sizing: border-box;
    background-color: white;
    box-shadow: 13px 13px 0 0 rgba(0 0 0 / 0.08);
    position: relative;
  }
  @media screen and (min-width: 768px) {
    .page {
      padding: 3rem;
    }
  }
  .copy {
    max-width: 32rem;
    margin: 1.5rem auto 0;
    font-size: 0.7rem;
    color: #555;
    padding-left: 52px;
    font-family: var(--font-oldstyle-serif);
  }
</style>
