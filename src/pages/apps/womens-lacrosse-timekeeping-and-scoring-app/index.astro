---
import { Picture, getImage } from "astro:assets";

import iconSrc from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/app-icon/original.png";
import IPhoneFrame from "../../../components/IPhoneFrame.astro";
import ScreenshotCarousel from "../../../components/ScreenshotCarousel.astro";
import screenshotActiveGame from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/screenshots/screenshot-active-game.png";
import screenshotEmptyGames from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/screenshots/screenshot-empty-games.png";
import screenshotReadyGame from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/screenshots/screenshot-ready-game.png";
import screenshotSettings from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/screenshots/screenshot-settings.png";
import screenshotTeams from "../../../images/womens-lacrosse-timekeeping-and-scoring-app/screenshots/screenshot-teams.png";

const iconAvif = await getImage({
  src: iconSrc,
  format: "avif",
  width: 32,
  height: 32,
});
const iconWebp = await getImage({
  src: iconSrc,
  format: "webp",
  width: 32,
  height: 32,
});
const iconPng = await getImage({
  src: iconSrc,
  format: "png",
  width: 32,
  height: 32,
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Women’s Lax time, score, and stat tracking app for iPhone."
    />
    <title>ScoreTable: Women&rsquo;s Lax App — Track Every Play</title>
    <link rel="icon" type="image/avif" href={iconAvif.src} />
    <link rel="icon" type="image/webp" href={iconWebp.src} />
    <link rel="icon" type="image/png" href={iconPng.src} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={Astro.url} />
    <script
      is:inline
      defer
      src="https://cloud.umami.is/script.js"
      data-website-id="31fd1927-b0ad-4bc5-8de8-a5d326e02548"></script>
    <style is:global>
      :root {
        --color-bg: #ffffff;
        --color-text: #252524;
        --color-muted: #5c5a55;
        --color-focus: #2f2d2b;
        --width-content: 640px;
        --font-sans:
          -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial,
          sans-serif;
        --space-xs: 0.5rem;
        --space-sm: 1rem;
        --space-md: 2rem;
        --space-lg: 4rem;
        --space-xl: 6rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        background-color: var(--color-bg);
        color: var(--color-text);
        font-family: var(--font-sans);
        font-size: 16px;
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      body {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--space-md) var(--space-sm);
      }

      :focus-visible {
        outline: 2px solid var(--color-focus);
        outline-offset: 3px;
        border-radius: 2px;
      }

      .skipLink {
        position: absolute;
        top: -100%;
        left: var(--space-sm);
        background: var(--color-text);
        color: var(--color-bg);
        padding: var(--space-xs) var(--space-sm);
        font-family: var(--font-sans);
        font-size: 0.875rem;
        text-decoration: none;
        z-index: 100;
        border-radius: 0 0 4px 4px;
      }

      .skipLink:focus {
        top: 0;
      }

      @media (max-width: 480px) {
        :root {
          --space-lg: 3rem;
          --space-xl: 4rem;
        }
      }

      /* header.css */
      .siteHeader {
        width: 100%;
        max-width: var(--width-content);
        margin-block-end: var(--space-xl);
      }

      .brand {
        display: flex;
        align-items: center;
        gap: var(--space-xs);
      }

      .appIcon {
        width: 32px;
        height: 32px;
        border-radius: 7px;
        display: block;
      }

      .wordmark {
        font-size: 1.125rem;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: var(--color-text);
      }

      .siteMain {
        width: 100%;
        max-width: var(--width-content);
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: var(--space-lg);
      }

      .hero {
        display: flex;
        flex-direction: column;
        gap: var(--space-sm);
      }

      .heading {
        font-size: clamp(2rem, 8vw, 3rem);
        font-weight: 500;
        line-height: 1.15;
        letter-spacing: -0.02em;
        color: var(--color-text);
      }

      .heroSub {
        font-size: 1.125rem;
        color: var(--color-muted);
        font-weight: 400;
      }

      .siteFooter {
        width: 100%;
        max-width: var(--width-content);
        margin-block-start: var(--space-xl);
      }

      .footerText,
      .footerLink {
        font-size: 0.8125rem;
        color: var(--color-muted);
        text-decoration: none;
      }
      .footerLink:hover {
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <a class="skipLink" href="#main">Skip to content</a>

    <header class="siteHeader">
      <div class="brand">
        <Picture
          src={iconSrc}
          formats={["avif", "webp"]}
          alt=""
          width={32}
          height={32}
          densities={[1, 2, 3]}
          class="appIcon"
        />
        <span class="wordmark">ScoreTable: Women&rsquo;s Lax App</span>
      </div>
    </header>

    <main id="main" class="siteMain">
      <section class="hero">
        <h1 class="heading">Track every play.</h1>
        <p class="heroSub">
          Keep time, score, and stats for women&rsquo;s lacrosse. Track goals,
          cards, draws, and 15+ player stats — or just run the clock. Built for
          NFHS rules.
        </p>
      </section>

      <IPhoneFrame screenBackground="rgb(243 243 243)">
        <ScreenshotCarousel
          images={[
            {
              src: screenshotActiveGame,
              alt: "Active game with score and clock running",
            },
            { src: screenshotReadyGame, alt: "Game ready to start" },
            { src: screenshotSettings, alt: "App settings" },
            { src: screenshotTeams, alt: "Teams list" },
            { src: screenshotEmptyGames, alt: "Empty games list" },
          ]}
        />
      </IPhoneFrame>
    </main>

    <footer class="siteFooter">
      <p class="footerText">
        &copy; 2026 <a href="/" class="footerLink">Wavering Light LLC</a>
      </p>
    </footer>
  </body>
</html>
