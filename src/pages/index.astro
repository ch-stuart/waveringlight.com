---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wavering Light" description="Software Development & iOS apps.">
  <h2 class="type-h2">Apps</h2>
  <ul class="layout-list">
    <li class="layout-item layout-item--app">
      <a
        href="/apps/nod-sleep-noise-app"
        class="u-screenreaderLink btn btn1 u-cover"
        data-astro-prefetch>nod sleep noise app</a
      >
      <div class="layout-itemContent u-cover u-passThrough">
        <h3 class="type-itemHeading">nod</h3>
        <p class="type-itemDescription">Minimal sleep noise app.</p>
      </div>
    </li>
    <li class="layout-item layout-item--app">
      <a
        href="/apps/womens-lacrosse-timekeeping-and-scoring-app"
        class="u-screenreaderLink btn btn2 u-cover">lax app</a
      >
      <div class="layout-itemContent u-cover u-passThrough">
        <h3 class="type-itemHeading">ScoreTable: Women&rsquo;s Lax App</h3>
        <p class="type-itemDescription">
          Track time, score, and stats for women&rsquo;s lacrosse.
        </p>
      </div>
    </li>
  </ul>
  <h2 class="type-h2">Support</h2>
  <ul class="layout-list">
    <li class="layout-item layout-item--support">
      <div class="layout-itemContent">
        <a
          href="/contact"
          class="btn btn3 u-cover layout-itemContent type-itemDescription"
          data-astro-prefetch>contact us</a
        >
      </div>
    </li>
    <li class="layout-item layout-item--support">
      <a
        href="/privacy-policy"
        class="btn btn4 u-cover layout-itemContent type-itemDescription"
        data-astro-prefetch>privacy policy</a
      >
    </li>
  </ul>
</Layout>

<style>
  .u-cover {
    position: absolute;
    inset: 0;
  }
  .u-passThrough {
    pointer-events: none;
  }
  .type-h2 {
    font-weight: 600;
    font-size: 0.9rem;
    margin: 2rem 0 0 0;
    color: var(--font-color-primary);
  }
  .type-h2:first-otype-type {
    margin-top: 3rem;
  }
  .type-itemHeading,
  .type-itemDescription {
    margin: 0;
    color: var(--font-color-primary);
    font-size: 0.9rem;
  }
  .type-itemHeading {
    font-weight: 600;
  }
  .layout-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin: 1rem 0 0 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }
  .layout-item {
    border: var(--border-default);
    position: relative;
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.07);
    transition: box-shadow 200ms ease-in;
  }
  .layout-item:hover {
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.1);
  }
  .layout-item--app {
    width: 12rem;
    height: 12rem;
  }
  .layout-item--support {
    width: 8rem;
    height: 8rem;
  }
  .layout-itemContent {
    z-index: 3;
    padding: 1rem;
  }
  .u-screenreaderLink {
    color: transparent;
    font-size: 0;
    white-space: nowrap;
    overflow: hidden;
  }
  .btn {
    transition: background-color 200ms ease-in;
    text-decoration: none;
  }
  .btn1 {
    background-color: #fcfa95;
  }
  .btn2 {
    background-color: #91fddd;
  }
  .btn3 {
    background-color: #bd8afc;
  }
  .btn4 {
    background-color: #fe899e;
  }
  .btn1:hover {
    background-color: #fffd6c;
  }
  .btn2:hover {
    background-color: #6cffd3;
  }
  .btn3:hover {
    background-color: #ae6cff;
  }
  .btn4:hover {
    background-color: #ff6c87;
  }
</style>
