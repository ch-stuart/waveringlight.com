---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Wavering Light" description="Software Development & iOS apps.">
  <h2 class="h2">Apps</h2>
  <ul class="list appList">
    <li class="item app">
      <a href="/apps/nod-sleep-noise-app" class="btn btn1" data-astro-prefetch
        >nod sleep noise app</a
      >
      <div class="desc">
        <h3 class="h3">nod</h3>
        <p class="appDesc">Minimal sleep noise app.</p>
      </div>
    </li>
    <li class="item app" style="display: none;">
      <a
        href="/apps/womens-lacrosse-timekeeping-and-scoring-app"
        class="btn btn2">lax app</a
      >
      <div class="desc">
        <h3 class="h3">Women's Lax App</h3>
        <p class="appDesc">
          Track time, score, and stats for women's lacrosse.
        </p>
      </div>
    </li>
  </ul>
  <h2 class="h2">Support</h2>
  <ul class="list supportList">
    <li class="item support">
      <a href="/contact" class="btn btn3" data-astro-prefetch>contact us</a>
      <div class="desc"><p class="appDesc">contact us</p></div>
    </li>
    <li class="item support">
      <a href="/privacy-policy" class="btn btn4" data-astro-prefetch
        >privacy policy</a
      >
      <div class="desc"><p class="appDesc">privacy policy</p></div>
    </li>
  </ul>
</Layout>

<style>
  .h2 {
    font-weight: 600;
    font-size: 0.9rem;
    margin: 2rem 0 0 0;
  }
  .h2:first-of-type {
    margin-top: 3rem;
  }
  .h3 {
    font-weight: 600;
    font-size: 0.9rem;
    margin: 0;
  }
  .appDesc {
    font-size: 0.9rem;
    margin-top: 0;
  }
  .list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    margin: 1rem 0 0 0;
    padding: 0;
    gap: 1rem;
    list-style: none;
  }
  .item {
    border: 2px solid #222;
    position: relative;
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.07);
    transition: box-shadow 200ms ease-in;
  }
  .item:hover {
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.1);
  }
  .app {
    width: 12rem;
    height: 12rem;
  }
  .support {
    width: 8rem;
    height: 8rem;
  }
  .btn {
    position: absolute;
    inset: 0;
    color: transparent;
    font-size: 0;
    white-space: nowrap;
    overflow: hidden;
    z-index: 2;
    transition: background-color 200ms ease-in;
  }
  .btn1 {
    background-color: #fcfa95;
  }
  .btn2 {
    background-color: #91fddd;
  }
  .btn3 {
    background-color: #bd8afc;
  }
  .btn4 {
    background-color: #fe899e;
  }

  .btn1:hover {
    background-color: #fffd6c;
  }
  .btn2:hover {
    background-color: #6cffd3;
  }
  .btn3:hover {
    background-color: #ae6cff;
  }
  .btn4:hover {
    background-color: #ff6c87;
  }
  .desc {
    position: absolute;
    inset: 1rem;
    z-index: 2;
    pointer-events: none;
  }
</style>
