---
interface Props {
  appId: string;
}
const { appId } = Astro.props;
import { Image } from "astro:assets";
import appInstallBadge from "./Download_on_the_App_Store_Badge_US-UK_RGB_blk_092917.svg";
---

<a href={`https://apps.apple.com/app/${appId}`}>
  <Image
    src={appInstallBadge}
    alt="Install Nod from the Apple App Store"
    width="120"
    height="40"
  />
</a>
