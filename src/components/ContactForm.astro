---
interface Props {
  redirectUrl?: string;
}

const { redirectUrl = "https://www.waveringlight.com/contact?success=true" } =
  Astro.props;

const accessKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;
---

<form action="https://api.web3forms.com/submit" method="POST">
  <input type="hidden" name="access_key" value={accessKey} />
  <input
    type="hidden"
    name="subject"
    value="Contact form — waveringlight.com"
  />
  <input type="hidden" name="from_name" value="Wavering Light Contact" />
  <input type="hidden" name="redirect" value={redirectUrl} />
  <input
    type="checkbox"
    name="botcheck"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="field">
    <label for="cf-name">Name</label>
    <input type="text" id="cf-name" name="name" required autocomplete="name" />
  </div>

  <div class="field">
    <label for="cf-email">Email</label>
    <input
      type="email"
      id="cf-email"
      name="email"
      required
      autocomplete="email"
    />
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <button type="submit">Send message</button>
</form>

<style>
  form {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  label {
    font-size: 0.9rem;
    font-weight: 500;
  }

  input,
  textarea {
    width: 80%;
    padding: 0.5rem 0.6rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-family: inherit;
    font-size: 1rem;
    line-height: 1.5;
    color: inherit;
  }

  input:focus,
  textarea:focus {
    outline: 2px solid #ae6cff;
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
  }

  button {
    align-self: flex-start;
    padding: 0.66666rem 1.22222rem;
    background-color: #bd8afc;
    color: var(--font-color-primary);
    border: var(--border-default);
    border-radius: 4px;
    font-family: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.07);
    transition: all 200ms ease-in;
    margin-top: 1rem;
  }

  button:focus {
    outline: 2px solid #8d30ff;
    outline-offset: 3px;
  }

  button:hover {
    background-color: #ae6cff;
    box-shadow: 4px 4px 0 0 rgba(0 0 0 / 0.1);
  }
</style>
